{
  "manifest_version": 3,
  "name": "Registro Lezioni Autofill",
  "short_name": "RegAutofill",
  "version": "0.1.0",
  "description": "Incrocia Google Calendar e University Planner e precompila il registro lezioni in U-WEB InTime. Il salvataggio resta all'utente.",
  "default_locale": "it",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "identity", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.up.cineca.it/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "INSERIRE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.readonly"]
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup/popup.html", "default_title": "Registro Lezioni Autofill" },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["https://*.up.cineca.it/*"],
      "js": ["src/content/up-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.up.cineca.it/*"],
      "js": ["src/content/up-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
